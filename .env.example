# Copy to .env and fill in the keys you have. Missing ones are skipped.
GROQ_API_KEY=        # console.groq.com  (required for agent.py)
GEMINI_API_KEY=      # aistudio.google.com
OPENROUTER_API_KEY=  # openrouter.ai
MISTRAL_API_KEY=     # console.mistral.ai
OLLAMA=1             # set if Ollama is running locally

# Optional: folder the agent may read/edit (default: the folder containing this project)
# AGENT_ROOT=C:\path\to\projects
